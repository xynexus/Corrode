[Unit]
Description=Corrode agent daemon (swarm, VFS, embedded HelixDB)
Documentation=file:%h/Corrode/CLAUDE.md
# hipfire must be up for role resolution + generation. Ordered after its unit when
# one exists (a missing unit is ignored); the daemon also retries hipfire's model
# list for CORRODE_RETRY_WINDOW_S before falling back (or, with CORRODE_ROLES set,
# refusing to start).
After=network-online.target hipfire.service
Wants=network-online.target hipfire.service

[Service]
Type=exec
# EnvironmentFile carries the deployment's config (see corrode.env.example). At
# minimum set CORRODE_REPO; turn on the sandbox and auth for a real deployment.
EnvironmentFile=%h/Corrode/deploy/corrode.env
# systemd's default PATH has no ~/.cargo/bin: without it the daemon's rustfmt
# normalizer and every cargo the (sandboxed) swarm runs is "not found".
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Corrode
# Build first: cargo build -p corrode-daemon --release --features helix,docling
#   (needs OpenSSL+pkg-config for helix — see CLAUDE.md). Point ExecStart at the
#   built binary; use debug/ if you haven't built --release.
ExecStart=%h/Corrode/target/release/corrode-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
