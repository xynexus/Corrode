# Copy to deploy/corrode.env (gitignored) and edit. Both units read this file.
# Only CORRODE_REPO is strictly required; the rest have working defaults.

# --- repo / binding ------------------------------------------------------
# The working dir/repo the daemon serves. Users can also switch at runtime
# via the UI's repo selector (SelectRepo), which is confined to real dirs.
CORRODE_REPO=/home/sadara/Corrode
CORRODE_DAEMON_ADDR=127.0.0.1:7878
CORRODE_WEB_ADDR=0.0.0.0:8787
CORRODE_DAEMON_URL=ws://127.0.0.1:7878/agent

# --- hipfire (inference) -------------------------------------------------
HIPFIRE_BASE_URL=http://127.0.0.1:11435
# HIPFIRE_API_KEY=...
# CORRODE_MODEL=...            # offline fallback model for all roles
# CORRODE_ROLES=/etc/corrode/roles.json

# --- multi-tenancy: sandbox + auth (turn ON for a real deployment) -------
# Confine every spawned process (terminals, run_command) with bubblewrap.
# Needs the AppArmor userns profile on Ubuntu 24.04 — see docs/corrode-doctor.md.
CORRODE_SANDBOX=on
# CORRODE_SANDBOX_NET=off      # deny network inside the sandbox (default off=deny)
# Per-user auth + per-user hipfire fairness. Absent => open/single-tenant.
# JSON: { "alice": { "token": "...", "hipfire_token": "..." }, ... }
# CORRODE_USERS=/etc/corrode/users.json

# --- graph / docs --------------------------------------------------------
# CORRODE_GRAPH_DIR is per-repo (<repo>/.corrode/database.helixdb) by default.
# CORRODE_EMBED_MODEL=...       # embedding model for doc/skill retrieval
